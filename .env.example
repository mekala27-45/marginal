# Copy to .env for a local run. Nothing here is needed for the pipeline or the site.

# The registry API. A Neon connection string in production; local Postgres in development.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/marginal
# Writes to /v1/plans and /v1/experiments carry this token in the Authorization header.
MARGINAL_WRITE_TOKEN=change-me
# Where the site reads the live API from at build time.
NEXT_PUBLIC_API_BASE=https://marginal-alderquist-api.fly.dev

# Tests: a reachable Postgres for the registry tests. Unset, the tests start a local
# cluster from the installed binaries or skip with a named reason.
MARGINAL_TEST_DATABASE_URL=

# Deploy: only the machine that runs `make deploy` needs these.
FLY_API_TOKEN=
FLY_APP_NAME=marginal-alderquist-api
