# The marginal API as a Vercel container function (free Hobby plan, no card): the same image as
# Dockerfile.api, listening on port 80, where Vercel sends the traffic. Vercel builds it from this file,
# starts an instance on the first request after idle and scales it to zero again; the migration runs at
# every start and is a no-op after the first.
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN pip install --no-cache-dir "uv>=0.8,<0.9"
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY packages ./packages
# The API package pulls the mix model interface without the bayes extra, so the image stays small.
RUN uv sync --frozen --no-dev --no-default-groups --package marginal-api
COPY results/mmm ./results/mmm
COPY results/experiments/registry.json ./results/experiments/registry.json
COPY results/calibrate ./results/calibrate
COPY results/clv ./results/clv
ENV MARGINAL_ROOT=/app PORT=80 PATH="/app/.venv/bin:$PATH" MARGINAL_ENV=production
EXPOSE 80
CMD ["sh", "-c", "cd packages/api && alembic upgrade head && cd /app && uvicorn marginal_api.main:app --host 0.0.0.0 --port ${PORT}"]
